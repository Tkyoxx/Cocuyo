{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cocuyo",
  "version": "0.2.1",
  "identifier": "io.github.tkyoxx.cocuyo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Cocuyo",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --in-process-gpu --enable-features=NetworkServiceInProcess2 --disable-background-networking --disable-component-update --disable-extensions"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; img-src 'self' data: blob: asset: http://asset.localhost https:; media-src 'self' asset: http://asset.localhost https:; font-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/dark.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "languages": ["Spanish", "English", "PortugueseBR"],
        "displayLanguageSelector": true
      }
    }
  }
}
