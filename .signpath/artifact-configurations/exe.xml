<?xml version="1.0" encoding="utf-8"?>
<!-- cocuyo.exe suelto: el mismo que bajan las copias al actualizarse -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="cocuyo.exe" product-name="Cocuyo" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
