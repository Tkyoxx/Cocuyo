<?xml version="1.0" encoding="utf-8"?>
<!-- el instalador nsis, que ya trae adentro el cocuyo.exe firmado -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Cocuyo_${version}_x64-setup.exe" product-name="Cocuyo" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
